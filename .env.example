# =========================================================
#  Konfigurasi Belantara (AWS)
#  Salin file ini menjadi .env. SEMUA opsional —
#  tanpa diisi, aplikasi jalan pakai data bundel (mode demo).
# =========================================================

# Port server lokal / EC2
PORT=3000

# --- AWS (layanan GRATIS yang disambung: S3 + DynamoDB) ---
# Kalau dikosongkan: katalog dari berkas bundel, order di memori/lokal.
# Kalau diisi: katalog dibaca dari S3 & order disimpan ke DynamoDB.
AWS_REGION=ap-southeast-1

# Amazon S3 — simpan katalog & aset (free tier 5 GB)
S3_BUCKET=
S3_CATALOG_KEY=catalog/products.json
S3_ASSET_PREFIX=images/

# Amazon DynamoDB — simpan pesanan (Always-Free 25 GB)
DYNAMODB_ORDERS_TABLE=

# Kredensial. Untuk lokal/Vercel pakai access key IAM (scope minimal:
# S3 bucket di atas + tabel DynamoDB di atas). Di EC2/Lambda kosongkan
# dua baris ini dan pasang IAM Role — SDK mengambil kredensial otomatis.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
