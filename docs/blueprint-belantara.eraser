// =====================================================================
//  Belantara Marketplace — Arsitektur AWS (15 layanan, 4 layer)
//
//  Layer 1 Edge & Security : Route 53, CloudFront, WAF, Cognito
//  Layer 2 Compute         : ALB, EC2 (Auto Scaling, multi-AZ)
//  Layer 3 Data & Storage  : RDS (Multi-AZ), ElastiCache, DynamoDB, S3, EFS
//  Layer 4 Data Lake       : Kinesis Firehose, S3 (lake), Glue, Athena, QuickSight
//
//  Sumber utama diagram: blueprint-belantara.drawio (draw.io, ikon AWS).
//  Cara pakai eraser: app.eraser.io -> New file -> Diagram-as-code
//  (cloud architecture) -> tempel seluruh isi file ini.
// =====================================================================

title Belantara Marketplace — Arsitektur AWS

Users [icon: users, label: "Pembeli & Seller"]

AWSCloud [icon: aws, label: "AWS Cloud"] {
  Edge [label: "Layer 1 - Edge & Security", color: red] {
    Route53 [icon: aws-route-53, label: "Amazon Route 53"]
    CloudFront [icon: aws-cloudfront, label: "Amazon CloudFront"]
    WAF [icon: aws-waf, label: "AWS WAF"]
    Cognito [icon: aws-cognito, label: "Amazon Cognito"]
  }
  Region [icon: aws, label: "Region ap-southeast-1 (Singapore)"] {
    VPC [icon: aws-vpc, label: "VPC 10.0.0.0/16", color: blue] {
      IGW [icon: aws-internet-gateway, label: "Internet Gateway"]
      ALB [icon: aws-elastic-load-balancing, label: "Application Load Balancer"]
      ASG [icon: aws-auto-scaling, label: "EC2 Auto Scaling"]
      AZ1 [label: "Availability Zone 1a"] {
        NAT1 [icon: aws-nat-gateway, label: "NAT Gateway"]
        EC2A [icon: aws-ec2, label: "EC2 Node.js"]
        CacheA [icon: aws-elasticache, label: "ElastiCache"]
        RDSP [icon: aws-rds, label: "RDS Primary"]
      }
      AZ2 [label: "Availability Zone 1b"] {
        NAT2 [icon: aws-nat-gateway, label: "NAT Gateway"]
        EC2B [icon: aws-ec2, label: "EC2 Node.js"]
        CacheB [icon: aws-elasticache, label: "ElastiCache"]
        RDSS [icon: aws-rds, label: "RDS Standby (Multi-AZ)"]
      }
    }
    S3 [icon: aws-simple-storage-service, label: "Amazon S3 (katalog, gambar)", color: green]
    DynamoDB [icon: aws-dynamodb, label: "Amazon DynamoDB (order, cart)"]
    EFS [icon: aws-elastic-file-system, label: "Amazon EFS (shared)", color: green]
    Lake [label: "Layer 4 - Data Lake & Analytics", color: purple] {
      Kinesis [icon: aws-kinesis-data-firehose, label: "Kinesis Data Firehose"]
      S3Lake [icon: aws-simple-storage-service, label: "Amazon S3 (Data Lake)"]
      Glue [icon: aws-glue, label: "AWS Glue"]
      Athena [icon: aws-athena, label: "Amazon Athena"]
      QuickSight [icon: aws-quicksight, label: "Amazon QuickSight"]
    }
  }
}

Users > CloudFront: HTTPS
Route53 > CloudFront: DNS
CloudFront > WAF
CloudFront > IGW: /api
Cognito > EC2A: auth
IGW > ALB
ALB > EC2A
ALB > EC2B
EC2A > RDSP
EC2A > CacheA
EC2A > DynamoDB: order/cart
EC2A > S3: objek
RDSP > RDSS: Multi-AZ
EC2B > Kinesis: events
Kinesis > S3Lake
S3Lake > Glue
Glue > Athena
Athena > QuickSight
