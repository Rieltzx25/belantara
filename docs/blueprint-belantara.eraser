// =====================================================================
//  Belantara Marketplace — Arsitektur HYBRID (AWS minimal + On-Premise)
//
//  Penyesuaian dari blueprint lama (full-AWS) ke versi hemat biaya:
//    - AWS menyusut: hanya VPC + EC2 yang tersisa.
//    - 6 layanan inti dipindah ke jaringan lokal berbasis open-source.
//    - DNS, CDN, keamanan perimeter, database, cache, file storage
//      semuanya self-host (biaya cloud = 0).
//
//  Sumber utama diagram ada di blueprint-belantara.drawio (draw.io).
//  Cara pakai eraser: app.eraser.io -> New file -> Diagram-as-code
//  (cloud architecture) -> tempel seluruh isi file ini.
// =====================================================================

title Belantara Marketplace — Arsitektur Hybrid

Users [icon: users, label: "Pembeli & Seller"]
DNS [icon: dns, label: "DNS - Registrar (Niagahoster/IDWebhost) atau BIND9", color: purple]

OnPrem [label: "On-Premise - Jaringan Lokal (LAN), open-source", color: gray] {
  Edge [label: "Edge & Perimeter Security", color: red] {
    Firewall [icon: shield, label: "UFW / iptables - firewall paket"]
    WAF [icon: shield, label: "ModSecurity (WAF)"]
    Nginx [icon: nginx, label: "1. Nginx - Reverse Proxy, CDN/cache, Load Balancer, TLS", color: green]
  }
  Data [label: "Data Tier - pengganti RDS & ElastiCache", color: blue] {
    DBMaster [icon: postgres, label: "3. PostgreSQL/MySQL MASTER (tulis)"]
    DBSlave [icon: postgres, label: "3. PostgreSQL/MySQL SLAVE/replica (baca)"]
    Redis [icon: redis, label: "4. Redis - cache query & sesi", color: red]
  }
  Storage [label: "Storage Tier - pengganti EFS & S3", color: orange] {
    NFS [icon: server, label: "5. NFS Cluster - shared folder antar-server (LAN)"]
    NAS [icon: hard-drive, label: "6. NAS / Storage Server - aset, gambar, order (SFTP/FTP)"]
  }
}

VPN [icon: aws-vpn-gateway, label: "Site-to-Site VPN / SSH Tunnel"]

AWSCloud [icon: aws, label: "AWS Cloud (menyusut)", color: gray] {
  Region [icon: aws, label: "Region ap-southeast-1", color: gray] {
    VPC [icon: aws-vpc, label: "VPC 10.0.0.0/16", color: blue] {
      Subnet [label: "Public Subnet 10.0.1.0/24"] {
        EC2 [icon: aws-ec2, label: "2. Amazon EC2 - Node.js (Public IP, tanpa NAT GW)"]
      }
    }
  }
}

Users > DNS: 1. resolve domain
Users > Firewall: 2. HTTPS
Firewall > WAF
WAF > Nginx
Nginx > EC2: 3. reverse proxy + LB (via VPN)
EC2 > DBMaster: 4. tulis
EC2 > DBSlave: 5. baca
DBMaster > DBSlave: replikasi
EC2 > Redis: 6. cache
EC2 > NFS: 7. shared files
EC2 > NAS: 8. gambar & aset (SFTP)
